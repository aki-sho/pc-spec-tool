{
  "name": "pc-spec-tool",
  "version": "1.0.3",
  "description": "PC spec viewer",
  "author": "akisho",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/window-security.test.cjs",
    "test:security": "node scripts/run-security-tests.cjs",
    "build": "electron-builder --win --x64",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  },
  "dependencies": {
    "systeminformation": "^5.33.19"
  },
  "devDependencies": {
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.example.pcspectool",
    "productName": "PC Spec Tool",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer/**/*",
      "templates/**/*",
      "services/**/*",
      "styles/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "PC-Spec-Tool-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "PC Spec Tool",
      "uninstallDisplayName": "PC Spec Tool",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "PC-Spec-Tool-Portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
